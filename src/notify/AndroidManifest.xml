<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.firewall.notify"
    android:versionCode="20"
    android:versionName="1.0.20">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="32" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:icon="@drawable/ic_stat_notify"
        android:label="Firewall Notify">

        <activity
            android:name=".PostNotificationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".NotifyService"
            android:directBootAware="true"
            android:exported="true"
            />

        <receiver
            android:name=".NotifyReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="app.firewall.notify.SHOW_BLOCKED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AllowCompleteReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="app.firewall.notify.ALLOW_COMPLETE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".AllowActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".AllowCompleteActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".OpenNetworkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
