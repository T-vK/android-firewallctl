#!/system/bin/sh
# On-device wrapper for firewallctl.
# Install: push to /data/local/tmp/ together with firewallctl.dex.jar,
# or via the Magisk module overlay at /system/bin/.
if [ -f /system/bin/firewallctl.dex.jar ]; then
    JAR=/system/bin/firewallctl.dex.jar
else
    DIR="$(cd "$(dirname "$0")" && pwd)"
    JAR="$DIR/firewallctl.dex.jar"
fi
if [ ! -f "$JAR" ]; then
    echo "firewallctl: cannot find $JAR" >&2
    exit 1
fi
export CLASSPATH="$JAR"

if [ "$1" = "notify-blocked" ]; then
    shift
    exec app_process /system/bin --nice-name=firewallctl-notify \
        app.firewallctl.BlockedAppNotifier "$@"
fi

exec app_process /system/bin --nice-name=firewallctl app.firewallctl.Main "$@"
