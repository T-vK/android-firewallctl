#!/system/bin/sh
# Allow network for a package: clear REJECT_ALL only (does not add to allowlist.txt).
# allowlist.txt is for manual admin exemptions only; reinstalls must be blocked again.
pkg="$1"
if [ -z "$pkg" ]; then
    echo "usage: firewall-allow-app <package>" >&2
    exit 2
fi

FIREWALLCTL="${FIREWALLCTL:-/system/bin/firewallctl}"

run_firewallctl() {
    if [ ! -x "$FIREWALLCTL" ]; then
        echo "firewall-allow-app: missing $FIREWALLCTL" >&2
        return 127
    fi
    if [ -x /system/bin/su ]; then
        /system/bin/su 0 "$FIREWALLCTL" "$@"
    else
        "$FIREWALLCTL" "$@"
    fi
}

if ! run_firewallctl clear "$pkg"; then
    echo "firewall-allow-app: clear failed for $pkg" >&2
    exit 1
fi
if ! run_firewallctl set "$pkg" -REJECT_ALL; then
    echo "firewall-allow-app: set -REJECT_ALL failed for $pkg" >&2
    exit 1
fi
echo "firewall-allow-app: network allowed for $pkg (REJECT_ALL cleared)"
