#!/system/bin/sh
# firewall-watcher: applies POLICY_REJECT_ALL to newly installed user apps.
#
# Event-driven via inotifyd on /data/system/. When packages.xml or
# packages.list changes, reconcile pm list packages -3 against a snapshot
# and apply +REJECT_ALL to anything new (minus the allowlist). A safety-net
# poll covers wedged/missing inotifyd.
#
# Modes:
#   firewall-watcher              daemon (started by service.sh)
#   firewall-watcher --reconcile  single reconcile pass (manual / safety poll)
#   firewall-watcher EVT DIR FILE   inotifyd callback (toybox/busybox)

STATE_DIR="${FIREWALL_STATE_DIR:-/data/adb/firewall_default_deny}"
SNAPSHOT="$STATE_DIR/known.txt"
ALLOWLIST="$STATE_DIR/allowlist.txt"
LOGFILE="$STATE_DIR/watcher.log"
LOCK="$STATE_DIR/reconcile.lock"
WATCH_DIR="${FIREWALL_WATCH_DIR:-/data/system}"
SAFETY_INTERVAL="${FIREWALL_WATCHER_SAFETY_INTERVAL:-60}"
FIREWALLCTL="${FIREWALLCTL:-/system/bin/firewallctl}"
INSTALL_SETTLE_SEC="${FIREWALL_INSTALL_SETTLE_SEC:-15}"

mkdir -p "$STATE_DIR"
touch "$ALLOWLIST"

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOGFILE"
}

is_allowlisted() {
    grep -vE '^[[:space:]]*(#|$)' "$ALLOWLIST" 2>/dev/null | grep -qxF "$1"
}

current_packages() {
    pm list packages -3 2>/dev/null | sed 's/^package://' | sort -u
}

run_firewallctl() {
    if [ ! -x "$FIREWALLCTL" ]; then
        log "ERROR: missing $FIREWALLCTL (is the module enabled?)"
        return 127
    fi
    if [ -x /system/bin/su ]; then
        /system/bin/su 0 "$FIREWALLCTL" "$@"
    else
        "$FIREWALLCTL" "$@"
    fi
}

package_visible() {
    pm list packages "$1" 2>/dev/null | grep -qxF "package:$1"
}

wait_for_package() {
    pkg="$1"
    waited=0
    while :; do
        if package_visible "$pkg"; then
            return 0
        fi
        if [ "$waited" -ge "$INSTALL_SETTLE_SEC" ]; then
            log "ERROR: $pkg not visible to pm after ${INSTALL_SETTLE_SEC}s"
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
}

NOTIFY_APK_COMPONENT="app.firewall.notify"
if [ -x /system/bin/pm ]; then
    AM=/system/bin/am
    PM=/system/bin/pm
    CMD=/system/bin/cmd
else
    AM=am
    PM=pm
    CMD=cmd
fi

# Watcher runs as root. Use root for am/cmd (matches "sudo am start" manual tests).
# su 2000 + am broadcast fails on some ROMs (Binder transaction 2147483646).
run_as_root() {
    _cmd="$1"
    if [ -x /system/bin/su ]; then
        /system/bin/su 0 sh -c "$_cmd"
    else
        sh -c "$_cmd"
    fi
}

notify_user_fallback() {
    pkg="$1"
    _intent="intent:#Intent;action=android.settings.APPLICATION_DETAILS_SETTINGS;data=package:${pkg};end"
    _text="${pkg} was installed and network access was disabled by default."
    _post="${CMD} notification post -t 'Internet blocked for new app' -c '${_intent}' 'firewall_default_deny_${pkg}' '${_text}'"
    if run_as_root "$_post" >>"$LOGFILE" 2>&1; then
        log "notify: shell notification posted for $pkg"
        return 0
    fi
    if [ -x /system/bin/su ]; then
        /system/bin/su 2000 sh -c "$_post" >>"$LOGFILE" 2>&1 && return 0
    fi
    return 1
}

notify_via_apk() {
    pkg="$1"
    _esc=$(printf '%s' "$pkg" | sed "s/'/'\\\\''/g")
    _act="${AM} start --user 0 -n ${NOTIFY_APK_COMPONENT}/.PostNotificationActivity --es package '${_esc}'"
    if run_as_root "$_act" >>"$LOGFILE" 2>&1; then
        log "notify: activity started for $pkg"
        return 0
    fi
    _svc="${AM} startservice --user 0 -n ${NOTIFY_APK_COMPONENT}/.NotifyService --es package '${_esc}'"
    if run_as_root "$_svc" >>"$LOGFILE" 2>&1; then
        log "notify: service started for $pkg"
        return 0
    fi
    _bc="${AM} broadcast --user 0 -a app.firewall.notify.SHOW_BLOCKED -n ${NOTIFY_APK_COMPONENT}/.NotifyReceiver --es package '${_esc}'"
    if run_as_root "$_bc" >>"$LOGFILE" 2>&1; then
        log "notify: broadcast sent for $pkg"
        return 0
    fi
    return 1
}

notify_user_inner() {
    pkg="$1"
    sleep 1
    if "$PM" path "$NOTIFY_APK_COMPONENT" >/dev/null 2>&1; then
        if notify_via_apk "$pkg"; then
            return 0
        fi
        log "WARN: FirewallNotify delivery failed for $pkg; using shell fallback"
    else
        log "WARN: FirewallNotify APK missing; using shell fallback for $pkg"
    fi
    notify_user_fallback "$pkg"
}

notify_user() {
    pkg="$1"
    if [ -n "${FIREWALL_NOTIFY_CMD:-}" ]; then
        "$FIREWALL_NOTIFY_CMD" "$pkg" >>"$LOGFILE" 2>&1 &
        return
    fi
    notify_user_inner "$pkg" >>"$LOGFILE" 2>&1 &
}


apply_deny() {
    pkg="$1"
    if is_allowlisted "$pkg"; then
        log "skip $pkg (allowlisted)"
        return 0
    fi
    if ! wait_for_package "$pkg"; then
        return 1
    fi
    if run_firewallctl set "$pkg" +REJECT_ALL >> "$LOGFILE" 2>&1; then
        log "blocked $pkg"
        notify_user "$pkg"
        return 0
    fi
    log "ERROR: firewallctl set +REJECT_ALL failed for $pkg"
    run_firewallctl list-policies >> "$LOGFILE" 2>&1 || true
    return 1
}

reconcile() {
    if ! mkdir "$LOCK" 2>/dev/null; then
        return 0
    fi
    if [ ! -f "$SNAPSHOT" ]; then
        current_packages > "$SNAPSHOT"
        log "initial snapshot: $(wc -l < "$SNAPSHOT") user packages"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if current=$(current_packages); then
        new=$(printf '%s\n' "$current" | comm -23 - "$SNAPSHOT" 2>/dev/null)
        if [ -n "$new" ]; then
            failfile="$STATE_DIR/.reconcile_failed"
            : > "$failfile"
            printf '%s\n' "$new" | while IFS= read -r pkg; do
                [ -n "$pkg" ] || continue
                if ! apply_deny "$pkg"; then
                    echo "$pkg" >> "$failfile"
                fi
            done
            if [ ! -s "$failfile" ]; then
                printf '%s\n' "$current" > "$SNAPSHOT"
            else
                log "reconcile: snapshot unchanged; failed: $(tr '\n' ' ' < "$failfile")"
            fi
            rm -f "$failfile"
        fi
    fi
    rmdir "$LOCK" 2>/dev/null
}

is_package_db_event() {
    for arg in "$@"; do
        case "$arg" in
            packages.xml|packages.list|*/packages.xml|*/packages.list)
                return 0
                ;;
        esac
    done
    return 1
}

case "$1" in
    --reconcile)
        reconcile
        exit 0
        ;;
    "")
        ;;
    *)
        if is_package_db_event "$@"; then
            reconcile
        fi
        exit 0
        ;;
esac

if [ ! -x "$FIREWALLCTL" ]; then
    log "ERROR: $FIREWALLCTL missing; module overlay not mounted?"
fi

if [ -f "$LOGFILE" ] && [ "$(wc -l < "$LOGFILE")" -gt 500 ]; then
    tail -n 500 "$LOGFILE" > "$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
fi

rmdir "$LOCK" 2>/dev/null

cleanup() {
    [ -n "$INOTIFY_SUP_PID" ] && kill "$INOTIFY_SUP_PID" 2>/dev/null
    rmdir "$LOCK" 2>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

log "firewall-watcher build=notify-apk-v4"

if command -v inotifyd >/dev/null 2>&1; then
    log "watcher starting (inotifyd on $WATCH_DIR, safety poll ${SAFETY_INTERVAL}s)"
else
    log "watcher starting (inotifyd MISSING, safety poll ${SAFETY_INTERVAL}s only)"
fi

reconcile

(
    while true; do
        if command -v inotifyd >/dev/null 2>&1; then
            inotifyd "$0" "${WATCH_DIR}:wcmynd" 2>>"$LOGFILE"
            log "inotifyd exited rc=$?, restarting in 5s"
            sleep 5
        else
            sleep 3600
        fi
    done
) &
INOTIFY_SUP_PID=$!

while true; do
    sleep "$SAFETY_INTERVAL"
    reconcile
done
