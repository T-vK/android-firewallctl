#!/system/bin/sh
# firewall-watcher: applies POLICY_REJECT_ALL to newly installed user apps.
#
# Event-driven via inotifyd on /data/system/. When packages.xml or
# packages.list changes, diff vs persisted install baseline (known.txt — not
# policy). allowlist.txt is manual-only (never written by the module). Notify
# first; firewallctl runs on an async block queue. A safety-net
# poll is a rare fallback only (no install-time polling).
#
# Modes:
#   firewall-watcher              daemon (started by service.sh)
#   firewall-watcher --reconcile  single reconcile pass (manual / safety poll)
#   firewall-watcher EVT DIR FILE   inotifyd callback (toybox/busybox)

STATE_DIR="${FIREWALL_STATE_DIR:-/data/adb/firewall_default_deny}"
SNAPSHOT="$STATE_DIR/known.txt"
INIT_FLAG="$STATE_DIR/.snapshot_initialized"
RECENT_UNINSTALL="$STATE_DIR/recent_uninstalled"
ALLOWLIST="$STATE_DIR/allowlist.txt"
LOGFILE="$STATE_DIR/watcher.log"
LOCK="$STATE_DIR/reconcile.lock"
WATCH_DIR="${FIREWALL_WATCH_DIR:-/data/system}"
SAFETY_INTERVAL="${FIREWALL_WATCHER_SAFETY_INTERVAL:-60}"
FIREWALLCTL="${FIREWALLCTL:-/system/bin/firewallctl}"
# Install settle polling removed; inotify on packages.xml/packages.list retries.

mkdir -p "$STATE_DIR"
ALLOW_QUEUE="$STATE_DIR/allow_queue"
ALLOW_QUEUE_LOCAL="/data/local/tmp/firewall_default_deny_allow"
ALLOW_FIFO="/data/local/tmp/firewall_default_deny_allow.fifo"
ALLOW_DONE="/data/local/tmp/firewall_default_deny_done"
touch "$ALLOWLIST"
touch "$STATE_DIR/block_queue" 2>/dev/null || true
touch "$ALLOW_QUEUE" "$ALLOW_QUEUE_LOCAL" 2>/dev/null || true
chmod 0666 "$ALLOW_QUEUE" "$ALLOW_QUEUE_LOCAL" 2>/dev/null || true
rm -f "$ALLOW_FIFO" 2>/dev/null || true
mkfifo "$ALLOW_FIFO" 2>/dev/null || true
chmod 0666 "$ALLOW_FIFO" 2>/dev/null || true
touch "$ALLOW_DONE" 2>/dev/null || true
chmod 0666 "$ALLOW_DONE" 2>/dev/null || true

# Android tool paths (must exist before --reconcile / inotify callbacks).
if [ -x /system/bin/pm ]; then
    AM=/system/bin/am
    PM=/system/bin/pm
    CMD=/system/bin/cmd
    APP_PROCESS=/system/bin/app_process
else
    AM=am
    PM=pm
    CMD=cmd
    APP_PROCESS=app_process
fi

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOGFILE"
}

# allowlist.txt = manual admin exemptions only (see customize.sh).
# "Allow network" in the notification does NOT add to allowlist.txt.
is_allowlisted() {
    _pkg="$1"
    grep -vE '^[[:space:]]*(#|$)' "$ALLOWLIST" 2>/dev/null | grep -qxF "$_pkg"
}


# Reinstall must block even if allowlist.txt still has a stale entry (e.g. old "Allow" button).
should_force_block() {
    _pkg="$1"
    if was_recently_uninstalled "$_pkg"; then
        return 0
    fi
    _newuid=$(package_uid "$_pkg")
    _olduid=$(snapshot_uid_for_pkg "$_pkg")
    if [ -n "$_newuid" ] && [ -n "$_olduid" ] && [ "$_newuid" != "$_olduid" ]; then
        return 0
    fi
    return 1
}

should_skip_blocking() {
    _pkg="$1"
    if ! is_allowlisted "$_pkg"; then
        return 1
    fi
    if should_force_block "$_pkg"; then
        return 1
    fi
    return 0
}

notified_stamp() {
    echo "$STATE_DIR/.notified/${1}"
}

mark_notified() {
    _pkg="$1"
    mkdir -p "$STATE_DIR/.notified"
    touch "$(notified_stamp "$_pkg")"
}

was_notified_recently() {
    _pkg="$1"
    _stamp=$(notified_stamp "$_pkg")
    [ -f "$_stamp" ] || return 1
    _now=$(date +%s 2>/dev/null) || return 0
    _mt=$(stat -c %Y "$_stamp" 2>/dev/null) || return 1
    [ $((_now - _mt)) -lt 120 ]
}


snapshot_pkg_names() {
    sed 's/ .*//' "$SNAPSHOT" 2>/dev/null | sort -u
}

count_new_package_names() {
    _current="$1"
    _curf="$STATE_DIR/.count_new_cur"
    _snapf="$STATE_DIR/.count_new_snap"
    _newf="$STATE_DIR/.count_new_out"
    printf '%s\n' "$_current" | sort -u >"$_curf"
    snapshot_pkg_names >"$_snapf"
    comm -23 "$_curf" "$_snapf" 2>/dev/null >"$_newf" || : >"$_newf"
    wc -l <"$_newf" | tr -d ' '
    rm -f "$_curf" "$_snapf" "$_newf"
}
count_package_lines() {
    _list="$1"
    _n=$(printf '%s\n' "$_list" | grep -cE '^[^[:space:]]' 2>/dev/null) || _n=0
    printf '%s' "$_n"
}

package_list_trusted() {
    _list="$1"
    _n=$(count_package_lines "$_list")
    [ "$_n" -ge "$MIN_USER_PACKAGES" ]
}

package_list_suspicious_drop() {
    _list="$1"
    _cur=$(count_package_lines "$_list")
    _prev=$(snapshot_pkg_names 2>/dev/null | grep -cE '^[^[:space:]]' 2>/dev/null) || _prev=0
    [ "$_prev" -ge "$MIN_USER_PACKAGES" ] && [ "$_cur" -lt "$MIN_USER_PACKAGES" ]
}

PACKAGES_LIST="${FIREWALL_PACKAGES_LIST:-/data/system/packages.list}"

current_packages() {
    "$PM" list packages -3 2>/dev/null | sed 's/^package://' | sort -u
}

package_uid() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    _uid=$("$PM" list packages -U "$_pkg" 2>/dev/null \
        | sed -n 's/.*uid:\([0-9][0-9]*\).*/\1/p' | head -1)
    if [ -n "$_uid" ]; then
        printf '%s' "$_uid"
        return 0
    fi
    [ -r "$PACKAGES_LIST" ] || return 1
    awk -v p="$_pkg" '$1 == p { print $2; exit }' "$PACKAGES_LIST" 2>/dev/null
}

snapshot_line_for() {
    _pkg="$1"
    _uid=$(package_uid "$_pkg")
    if [ -n "$_uid" ]; then
        printf '%s %s' "$_pkg" "$_uid"
    else
        printf '%s' "$_pkg"
    fi
}

snapshot_has_pkg() {
    _pkg="$1"
    grep -qxF "$_pkg" "$SNAPSHOT" 2>/dev/null && return 0
    grep -q "^${_pkg} " "$SNAPSHOT" 2>/dev/null
}

snapshot_uid_for_pkg() {
    _pkg="$1"
    grep -m1 "^${_pkg} " "$SNAPSHOT" 2>/dev/null | awk '{print $2}'
}

note_uninstalled_pkg() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 0
    grep -qxF "$_pkg" "$RECENT_UNINSTALL" 2>/dev/null && return 0
    printf '%s\n' "$_pkg" >>"$RECENT_UNINSTALL"
}

clear_uninstalled_pkg() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 0
    [ ! -f "$RECENT_UNINSTALL" ] && return 0
    _t="$STATE_DIR/.recent_uninstall_tmp"
    grep -vxF "$_pkg" "$RECENT_UNINSTALL" 2>/dev/null >"$_t" || : >"$_t"
    mv "$_t" "$RECENT_UNINSTALL"
}

was_recently_uninstalled() {
    _pkg="$1"
    grep -qxF "$_pkg" "$RECENT_UNINSTALL" 2>/dev/null
}

# Block: package name not in snapshot, recent uninstall, or UID change (reinstall).
should_block_pkg() {
    _pkg="$1"
    if was_recently_uninstalled "$_pkg"; then
        return 0
    fi
    if ! snapshot_has_pkg "$_pkg"; then
        return 0
    fi
    _newuid=$(package_uid "$_pkg")
    _olduid=$(snapshot_uid_for_pkg "$_pkg")
    if [ -n "$_newuid" ] && [ -n "$_olduid" ] && [ "$_newuid" != "$_olduid" ]; then
        return 0
    fi
    if [ -n "$_newuid" ] && grep -qxF "$_pkg" "$SNAPSHOT" 2>/dev/null; then
        [ -z "$_olduid" ] && return 0
    fi
    return 1
}

record_snapshot_pkg() {
    _pkg="$1"
    _line=$(snapshot_line_for "$_pkg")
    grep -qxF "$_line" "$SNAPSHOT" 2>/dev/null && return 0
    _tmp="$STATE_DIR/.snapshot_pkg"
    if [ -f "$SNAPSHOT" ]; then
        while IFS= read -r _row || [ -n "$_row" ]; do
            [ -z "$_row" ] && continue
            case "$_row" in
                "$_pkg"|"${_pkg} "*)
                    ;;
                *)
                    printf '%s\n' "$_row"
                    ;;
            esac
        done <"$SNAPSHOT" >"$_tmp" 2>/dev/null || : >"$_tmp"
        mv "$_tmp" "$SNAPSHOT"
    fi
    printf '%s\n' "$_line" >>"$SNAPSHOT"
}

prune_uninstalled_from_snapshot() {
    _cur="$STATE_DIR/.reconcile_pkgnames"
    if [ -n "${1:-}" ]; then
        printf '%s
' "$1" >"$_cur"
    else
        current_packages >"$_cur"
    fi
    [ -s "$_cur" ] || return 0
    _tmp="$STATE_DIR/.snapshot_pruned"
    while IFS= read -r _row || [ -n "$_row" ]; do
        [ -z "$_row" ] && continue
        _pkg=${_row%% *}
        if grep -qxF "$_pkg" "$_cur" 2>/dev/null; then
            printf '%s\n' "$_row"
        else
            note_uninstalled_pkg "$_pkg"
        fi
    done <"$SNAPSHOT" >"$_tmp" 2>/dev/null || : >"$_tmp"
    mv "$_tmp" "$SNAPSHOT"
    rm -f "$_cur"
}

# Record every currently installed user app; never block during bootstrap.
bootstrap_snapshot() {
    _cur=$(current_packages) || _cur=""
    if ! package_list_trusted "$_cur"; then
        _n=$(count_package_lines "$_cur")
        log "SAFETY: bootstrap skipped (only $_n user packages; need >= $MIN_USER_PACKAGES)"
        return 1
    fi
    _tmp="$SNAPSHOT.tmp.$$"
    : >"$_tmp"
    printf '%s\n' "$_cur" | while IFS= read -r _pkg; do
        [ -n "$_pkg" ] || continue
        _line=$(snapshot_line_for "$_pkg")
        printf '%s\n' "$_line" >>"$_tmp"
    done
    mv "$_tmp" "$SNAPSHOT"
    touch "$INIT_FLAG"
    log "bootstrap baseline: $(wc -l < "$SNAPSHOT") packages recorded (no blocking)"
}

# If the snapshot is missing/empty or a reconcile would block too many apps at once,
# rebuild known.txt without touching network policy (prevents mass-block accidents).
MASS_BLOCK_LIMIT="${FIREWALL_MASS_BLOCK_LIMIT:-10}"
MIN_USER_PACKAGES="${FIREWALL_MIN_USER_PACKAGES:-5}"
BLOCK_QUEUE="$STATE_DIR/block_queue"

needs_bootstrap() {
    [ ! -f "$INIT_FLAG" ]
}


collect_block_candidates() {
    _current="$1"
    _out="$2"
    _tmp="$STATE_DIR/.reconcile_block_tmp"
    : >"$_out"
    _names="$STATE_DIR/.reconcile_cur_names"
    _snap="$STATE_DIR/.reconcile_snap_names"
    printf '%s\n' "$_current" | sort -u >"$_names"
    snapshot_pkg_names >"$_snap"
    comm -23 "$_names" "$_snap" >>"$_out" 2>/dev/null
    rm -f "$_names" "$_snap"
    if [ -f "$RECENT_UNINSTALL" ]; then
        while IFS= read -r _pkg || [ -n "$_pkg" ]; do
            [ -z "$_pkg" ] && continue
            printf '%s\n' "$_current" | grep -qxF "$_pkg" || continue
            printf '%s\n' "$_pkg" >>"$_out"
        done <"$RECENT_UNINSTALL"
    fi
    if [ -r "$PACKAGES_LIST" ]; then
        awk -v snap="$SNAPSHOT" '
        BEGIN {
            while ((getline line < snap) > 0) {
                n = split(line, a, " ")
                if (n >= 2) olduid[a[1]] = a[2]
                else if (n >= 1 && a[1] != "") nameonly[a[1]] = 1
            }
        }
        NF >= 1 {
            pkg = $1
            newuid = $2
            if (pkg in olduid && newuid != "" && olduid[pkg] != newuid) print pkg
            else if ((pkg in nameonly) && newuid != "") print pkg
        }
        ' "$PACKAGES_LIST" >>"$_out" 2>/dev/null
    fi
    sort -u "$_out" >"$_tmp" 2>/dev/null || : >"$_tmp"
    mv "$_tmp" "$_out"
}

mass_block_detected() {
    _n="$1"
    [ "$_n" -gt "$MASS_BLOCK_LIMIT" ]
}

run_firewallctl() {
    if [ ! -x "$FIREWALLCTL" ]; then
        log "ERROR: missing $FIREWALLCTL (is the module enabled?)"
        return 127
    fi
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        "$FIREWALLCTL" "$@"
        return $?
    fi
    if [ -x /system/bin/su ]; then
        /system/bin/su 0 "$FIREWALLCTL" "$@"
    else
        "$FIREWALLCTL" "$@"
    fi
}

NOTIFY_APK_COMPONENT="app.firewall.notify"
NOTIFY_RUNNER=app.firewall.notify.NotifyRunner
ALLOW_COMPLETE_RUNNER=app.firewall.notify.AllowCompleteRunner


# Resolve app_process: "test -x app_process" does not search PATH.
if [ ! -x "$APP_PROCESS" ] 2>/dev/null; then
    _ap=$(command -v app_process 2>/dev/null) || true
    if [ -n "$_ap" ] && [ -x "$_ap" ]; then
        APP_PROCESS="$_ap"
    fi
fi
if [ ! -x "$CMD" ] 2>/dev/null; then
    _cmd=$(command -v cmd 2>/dev/null) || true
    [ -n "$_cmd" ] && [ -x "$_cmd" ] && CMD="$_cmd"
fi
if [ ! -x "$AM" ] 2>/dev/null; then
    _am=$(command -v am 2>/dev/null) || true
    [ -n "$_am" ] && [ -x "$_am" ] && AM="$_am"
fi

notify_module_apk() {
    _mod="${MODDIR:-/data/adb/modules/firewall_default_deny}"
    if [ -f "$_mod/system/priv-app/FirewallNotify/FirewallNotify.apk" ]; then
        echo "$_mod/system/priv-app/FirewallNotify/FirewallNotify.apk"
        return 0
    fi
    if [ -f "$_mod/FirewallNotify.apk" ]; then
        echo "$_mod/FirewallNotify.apk"
        return 0
    fi
    return 1
}

notify_apk_path() {
    _p=$("$PM" path "$NOTIFY_APK_COMPONENT" 2>/dev/null | head -1 | sed 's/^package://')
    if [ -n "$_p" ] && [ -f "$_p" ]; then
        echo "$_p"
        return 0
    fi
    notify_module_apk
}
notify_apk_data_dir() {
    if [ -d "/data/user/0/$NOTIFY_APK_COMPONENT" ]; then
        echo "/data/user/0/$NOTIFY_APK_COMPONENT"
        return 0
    fi
    if [ -d "/data/data/$NOTIFY_APK_COMPONENT" ]; then
        echo "/data/data/$NOTIFY_APK_COMPONENT"
        return 0
    fi
    return 1
}

notify_apk_uid() {
    "$PM" list packages -U "$NOTIFY_APK_COMPONENT" 2>/dev/null         | sed -n 's/.*uid:\([0-9]*\).*/\1/p' | head -1
}

# Run a command as FirewallNotify UID so NotificationManager posts are not dropped.
run_as_notify_apk() {
    _uid=$(notify_apk_uid)
    if [ -n "$_uid" ] && [ -x /system/bin/su ]; then
        /system/bin/su "$_uid" "$@"
        return $?
    fi
    "$@"
}

notify_via_broadcast() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    if [ -x "$CMD" ] && "$CMD" activity broadcast --user 0             -a app.firewall.notify.SHOW_BLOCKED             --es package "$_pkg"             -p app.firewall.notify >/dev/null 2>>"$LOGFILE"; then
        return 0
    fi
    if "$AM" broadcast --user 0             -a app.firewall.notify.SHOW_BLOCKED             --es package "$_pkg"             -p app.firewall.notify >/dev/null 2>>"$LOGFILE"; then
        return 0
    fi
    if "$AM" broadcast --user 0             -a app.firewall.notify.SHOW_BLOCKED             --es package "$_pkg"             -n "${NOTIFY_APK_COMPONENT}/.NotifyReceiver" >/dev/null 2>>"$LOGFILE"; then
        return 0
    fi
    return 1
}

notify_allow_complete_cache() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    _base=$(notify_apk_data_dir) || return 1
    _cache="$_base/cache"
    _marker="$_cache/firewall_allow_complete"
    mkdir -p "$_cache" 2>/dev/null || return 1
    printf '%s\n' "$_pkg" > "$_marker"
    _uid=$("$PM" list packages -U "$NOTIFY_APK_COMPONENT" 2>/dev/null         | sed -n 's/.*uid:\([0-9]*\).*/\1/p' | head -1)
    if [ -n "$_uid" ]; then
        chown "$_uid:$_uid" "$_marker" 2>/dev/null             || chown "$_uid" "$_marker" 2>/dev/null || true
    fi
    chmod 640 "$_marker" 2>/dev/null || true
    return 0
}

notify_allow_complete_activity() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    "$AM" start --user 0         -n "${NOTIFY_APK_COMPONENT}/.AllowCompleteActivity"         --es package "$_pkg"         -f 0x10000000 >>"$LOGFILE" 2>&1
}


run_notify_apk_runner() {
    _runner="$1"
    shift
    _apk=$(notify_apk_path)
    if [ -z "$_apk" ] || [ ! -f "$_apk" ]; then
        return 1
    fi
    if [ -z "$APP_PROCESS" ] || [ ! -x "$APP_PROCESS" ]; then
        return 1
    fi
    _uid=$(notify_apk_uid)
    if [ -n "$_uid" ] && [ -x /system/bin/su ]; then
        _args=""
        for _a in "$@"; do
            _esc=$(printf '%s' "$_a" | sed "s/'/'\''/g")
            _args="$_args '$_esc'"
        done
        /system/bin/su "$_uid" /system/bin/sh -c \
            "CLASSPATH='$_apk' exec '$APP_PROCESS' /system/bin --nice-name=firewall-notify '$_runner'$_args" \
            >>"$LOGFILE" 2>&1
        return $?
    fi
    CLASSPATH="$_apk" "$APP_PROCESS" /system/bin --nice-name=firewall-notify \
        "$_runner" "$@" >>"$LOGFILE" 2>&1
}

notify_via_app_process() {
    pkg="$1"
    run_notify_apk_runner "$NOTIFY_RUNNER" "$pkg"
}

notify_shell_cmd() {
    pkg="$1"
    _tag="firewall_default_deny_${pkg}"
    _text="${pkg} was installed and network access was disabled by default."
    if [ -x /system/bin/su ]; then
        /system/bin/su 2000 "$CMD" notification post \
            -t "Internet blocked for new app" \
            -S bigtext \
            "$_tag" \
            "$_text" >/dev/null 2>>"$LOGFILE" && return 0
    fi
    "$CMD" notification post \
        -t "Internet blocked for new app" \
        -S bigtext \
        "$_tag" \
        "$_text" >/dev/null 2>>"$LOGFILE"
}

notify_via_am_direct() {
    pkg="$1"
    if run_as_notify_apk "$AM" start --user 0 -f 0x10000000             -n "${NOTIFY_APK_COMPONENT}/.PostNotificationActivity"             --es package "$pkg" >/dev/null 2>>"$LOGFILE"; then
        return 0
    fi
    if "$AM" start --user 0 -f 0x10000000             -n "${NOTIFY_APK_COMPONENT}/.PostNotificationActivity"             --es package "$pkg" >/dev/null 2>>"$LOGFILE"; then
        return 0
    fi
    if run_as_notify_apk "$AM" startservice --user 0             -n "${NOTIFY_APK_COMPONENT}/.NotifyService"             --es package "$pkg" >/dev/null 2>>"$LOGFILE"; then
        return 0
    fi
    "$AM" startservice --user 0         -n "${NOTIFY_APK_COMPONENT}/.NotifyService"         --es package "$pkg" >/dev/null 2>>"$LOGFILE" && return 0
    return 1
}

notify_user_inner() {
    pkg="$1"
    if notify_via_broadcast "$pkg"; then
        log "notify: broadcast posted for $pkg"
        return 0
    fi
    if notify_via_am_direct "$pkg"; then
        log "notify: am posted for $pkg"
        return 0
    fi
    if notify_via_app_process "$pkg"; then
        log "notify: app_process posted for $pkg"
        return 0
    fi
    if notify_shell_cmd "$pkg"; then
        log "notify: cmd notification posted for $pkg"
        return 0
    fi
    log "ERROR: all notify paths failed for $pkg"
    return 1
}

notify_user() {
    pkg="$1"
    if was_notified_recently "$pkg"; then
        return 0
    fi
    if [ -n "${FIREWALL_NOTIFY_CMD:-}" ]; then
        "$FIREWALL_NOTIFY_CMD" "$pkg" >>"$LOGFILE" 2>&1
        mark_notified "$pkg"
        return
    fi
    if notify_user_inner "$pkg"; then
        mark_notified "$pkg"
        log "notify: posted for $pkg"
    else
        log "ERROR: notify failed for $pkg"
    fi
}


notify_allow_complete() {
    _pkg="$1"
    _marker="${2:-}"
    _rc=1
    if [ -z "$_pkg" ]; then
        return 1
    fi
    if write_allow_marker "$_pkg" "$_marker"; then
        log "allow: marker for $_pkg ($_marker)"
        _rc=0
    elif notify_allow_complete_cache "$_pkg"; then
        log "allow: cache marker for $_pkg"
        _rc=0
    fi
    if notify_allow_complete_activity "$_pkg"; then
        log "allow: activity ALLOW_COMPLETE for $_pkg"
        return 0
    fi
    if run_notify_apk_runner "$ALLOW_COMPLETE_RUNNER" "$_pkg"; then
        log "allow: app_process ALLOW_COMPLETE for $_pkg"
        return 0
    fi
    if [ "$_rc" -eq 0 ]; then
        return 0
    fi
    if [ -x "$CMD" ] && "$CMD" activity broadcast --user 0 \
            -a app.firewall.notify.ALLOW_COMPLETE \
            --es package "$_pkg" \
            -p app.firewall.notify >>"$LOGFILE" 2>&1; then
        return 0
    fi
    if "$AM" broadcast --user 0 \
            -a app.firewall.notify.ALLOW_COMPLETE \
            --es package "$_pkg" \
            -p app.firewall.notify >>"$LOGFILE" 2>&1; then
        return 0
    fi
    if "$AM" broadcast --user 0 \
            -a app.firewall.notify.ALLOW_COMPLETE \
            --es package "$_pkg" \
            -n app.firewall.notify/.AllowCompleteReceiver >>"$LOGFILE" 2>&1; then
        return 0
    fi
    log "allow: ALLOW_COMPLETE signal failed for $_pkg"
    return 1
}



parse_allow_line() {
    _line="$1"
    _pkg="${_line%%	*}"
    _marker="${_line#*	}"
    if [ "$_pkg" = "$_marker" ]; then
        _marker=""
    fi
    _pkg=$(printf '%s' "$_pkg" | tr -d '
')
    _marker=$(printf '%s' "$_marker" | tr -d '
')
}

write_allow_marker() {
    _pkg="$1"
    _marker="$2"
    [ -n "$_pkg" ] || return 1
    if [ -z "$_marker" ]; then
        notify_allow_complete_cache "$_pkg" || return 1
        return 0
    fi
    _dir=$(dirname "$_marker")
    mkdir -p "$_dir" 2>/dev/null || return 1
    printf '%s\n' "$_pkg" > "$_marker"
    _uid=$("$PM" list packages -U "$NOTIFY_APK_COMPONENT" 2>/dev/null \
        | sed -n 's/.*uid:\([0-9]*\).*/\1/p' | head -1)
    if [ -n "$_uid" ]; then
        chown "$_uid:$_uid" "$_marker" 2>/dev/null \
            || chown "$_uid" "$_marker" 2>/dev/null || true
    fi
    chmod 640 "$_marker" 2>/dev/null || true
    return 0
}

is_block_queued() {
    _pkg="$1"
    [ -n "$_pkg" ] && [ -f "$BLOCK_QUEUE" ] && grep -qxF "$_pkg" "$BLOCK_QUEUE" 2>/dev/null
}

enqueue_allow_request() {
    _pkg="$1"
    _marker="${2:-}"
    [ -n "$_pkg" ] || return 1
    if [ -n "$_marker" ]; then
        printf '%s\t%s\n' "$_pkg" "$_marker" >>"$ALLOW_QUEUE_LOCAL"
        printf '%s\t%s\n' "$_pkg" "$_marker" >>"$ALLOW_QUEUE"
    else
        printf '%s\n' "$_pkg" >>"$ALLOW_QUEUE_LOCAL"
        printf '%s\n' "$_pkg" >>"$ALLOW_QUEUE"
    fi
}

allow_one_package() {
    _pkg="$1"
    _marker="${2:-}"
    [ -n "$_pkg" ] || return 1
    if is_block_queued "$_pkg"; then
        enqueue_allow_request "$_pkg" "$_marker"
        log "allow: queued $_pkg (block in progress)"
        return 0
    fi
    if [ ! -x /system/bin/firewall-allow-app ]; then
        log "allow: missing /system/bin/firewall-allow-app"
        return 1
    fi
    if /system/bin/firewall-allow-app "$_pkg" >>"$LOGFILE" 2>&1; then
        log "allow: allowed $_pkg"
        record_snapshot_pkg "$_pkg"
        notify_allow_complete "$_pkg" "$_marker"
        return 0
    fi
    log "allow: firewall-allow-app failed for $_pkg"
    return 1
}

process_allow_queue() {
    _lock="$STATE_DIR/allow_queue.lock"
    if ! mkdir "$_lock" 2>/dev/null; then
        return 0
    fi
    for _q in "$ALLOW_QUEUE_LOCAL" "$ALLOW_QUEUE"; do
        if [ ! -s "$_q" ]; then
            continue
        fi
        while IFS= read -r _line || [ -n "$_line" ]; do
            [ -z "$_line" ] && continue
            parse_allow_line "$_line"
            allow_one_package "$_pkg" "$_marker"
        done <"$_q"
        : >"$_q"
    done
    rmdir "$_lock" 2>/dev/null
}

start_allow_queue_poller() {
    (
        while true; do
            process_allow_queue
            sleep 1
        done
    ) &
    ALLOW_QUEUE_PID=$!
}

start_allow_fifo_reader() {
    (
        while true; do
            process_allow_queue
            if [ ! -p "$ALLOW_FIFO" ]; then
                rm -f "$ALLOW_FIFO" 2>/dev/null || true
                mkfifo "$ALLOW_FIFO" 2>/dev/null || true
                chmod 0666 "$ALLOW_FIFO" 2>/dev/null || true
                sleep 1
                continue
            fi
            if read -r _line <"$ALLOW_FIFO" 2>/dev/null; then
                [ -z "$_line" ] && continue
                parse_allow_line "$_line"
                allow_one_package "$_pkg" "$_marker"
            fi
        done
    ) &
    ALLOW_FIFO_PID=$!
}


enqueue_block_packages() {
    _list="$1"
    [ -s "$_list" ] || return 0
    while IFS= read -r _pkg || [ -n "$_pkg" ]; do
        [ -n "$_pkg" ] || continue
        should_skip_blocking "$_pkg" && continue
        grep -qxF "$_pkg" "$BLOCK_QUEUE" 2>/dev/null && continue
        printf '%s\n' "$_pkg" >>"$BLOCK_QUEUE"
    done <"$_list"
}

run_block_queue_pass() {
    _failfile="$STATE_DIR/.block_queue_failed"
    while [ -s "$BLOCK_QUEUE" ]; do
        _pkg=$(head -1 "$BLOCK_QUEUE" 2>/dev/null)
        [ -n "$_pkg" ] || break
        _rest="$STATE_DIR/.block_queue_rest"
        tail -n +2 "$BLOCK_QUEUE" 2>/dev/null >"$_rest" || : >"$_rest"
        mv "$_rest" "$BLOCK_QUEUE"
        if apply_block_policy "$_pkg"; then
            record_snapshot_pkg "$_pkg"
        else
            printf '%s\n' "$_pkg" >>"$_failfile"
        fi
        process_allow_queue
    done
    if [ -s "$_failfile" ]; then
        log "block queue: failed: $(tr '\n' ' ' <"$_failfile")"
        rm -f "$_failfile"
    fi
}

start_block_worker() {
    (
        while true; do
            if [ -s "$BLOCK_QUEUE" ]; then
                if mkdir "$STATE_DIR/block_worker.lock" 2>/dev/null; then
                    run_block_queue_pass
                    rmdir "$STATE_DIR/block_worker.lock" 2>/dev/null
                fi
            fi
            sleep 0.25
        done
    ) &
    BLOCK_WORKER_PID=$!
}


notify_block_candidates() {
    _list="$1"
    [ -s "$_list" ] || return 0
    while IFS= read -r pkg || [ -n "$pkg" ]; do
        [ -n "$pkg" ] || continue
        if should_skip_blocking "$pkg"; then
            continue
        fi
        if was_notified_recently "$pkg"; then
            continue
        fi
        notify_user "$pkg"
    done <"$_list"
}

apply_block_policy() {
    pkg="$1"
    if should_skip_blocking "$pkg"; then
        log "skip $pkg (allowlisted)"
        clear_uninstalled_pkg "$pkg"
        record_snapshot_pkg "$pkg"
        return 0
    fi
    if run_firewallctl set "$pkg" +REJECT_ALL >> "$LOGFILE" 2>&1; then
        log "blocked $pkg"
        clear_uninstalled_pkg "$pkg"
        return 0
    fi
    log "ERROR: firewallctl set +REJECT_ALL failed for $pkg"
    run_firewallctl list-policies >> "$LOGFILE" 2>&1 || true
    return 1
}

# Notify-only when reconcile lock is held (packages.list already changed).
reconcile_notify_only() {
    _current="$1"
    _nf="$STATE_DIR/.reconcile_notify_only"
    collect_block_candidates "$_current" "$_nf"
    notify_block_candidates "$_nf"
    rm -f "$_nf"
}

# Immediate notify on package DB writes (same event source as install-detect benchmark).
# Runs without the reconcile lock so a slow block pass cannot delay the heads-up.
reconcile_install_event() {
    [ -f "$INIT_FLAG" ] || return 0
    [ ! -s "$SNAPSHOT" ] && return 0
    _current=$(current_packages) || return 0
    package_list_trusted "$_current" || return 0
    package_list_suspicious_drop "$_current" && return 0
    _nf="$STATE_DIR/.reconcile_install_event"
    collect_block_candidates "$_current" "$_nf"
    [ -s "$_nf" ] || return 0
    while IFS= read -r _pkg || [ -n "$_pkg" ]; do
        [ -n "$_pkg" ] || continue
        if should_skip_blocking "$_pkg"; then
            continue
        fi
        notify_user "$_pkg"
    done <"$_nf"
    rm -f "$_nf"
}

reconcile_stale_lock() {
    if [ ! -d "$LOCK" ]; then
        return 0
    fi
    _age=0
    _now=$(date +%s 2>/dev/null) || return 0
    _mtime=$(stat -c %Y "$LOCK" 2>/dev/null) || return 0
    _age=$((_now - _mtime))
    if [ "$_age" -gt 45 ]; then
        log "reconcile: clearing stale lock (${_age}s)"
        rmdir "$LOCK" 2>/dev/null || rm -rf "$LOCK" 2>/dev/null
    fi
}

reconcile() {
    reconcile_stale_lock
    if ! mkdir "$LOCK" 2>/dev/null; then
        _cur=$(current_packages) || return 0
        if [ -f "$INIT_FLAG" ] && [ -s "$SNAPSHOT" ]; then
            reconcile_notify_only "$_cur"
        fi
        return 0
    fi
    if ! current=$(current_packages); then
        log "WARN: pm list packages -3 failed; skipping reconcile"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if ! package_list_trusted "$current"; then
        _n=$(count_package_lines "$current")
        log "SAFETY: untrusted package list ($_n apps < $MIN_USER_PACKAGES); skipping reconcile"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if package_list_suspicious_drop "$current"; then
        log "SAFETY: suspicious package drop vs baseline; skipping reconcile"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if needs_bootstrap; then
        if bootstrap_snapshot; then
            :
        else
            log "SAFETY: bootstrap deferred (package list not ready)"
        fi
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if [ ! -s "$SNAPSHOT" ]; then
        log "WARN: snapshot empty; rebuilding without blocking"
        bootstrap_snapshot
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    _newfile="$STATE_DIR/.reconcile_new"
    collect_block_candidates "$current" "$_newfile"
    if [ ! -s "$_newfile" ]; then
        prune_uninstalled_from_snapshot "$current"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    _nnew=$(wc -l < "$_newfile")
    _nnew_names=$(count_new_package_names "$current")
    if mass_block_detected "$_nnew_names"; then
        log "SAFETY: $_nnew_names new package name(s) would be blocked (limit $MASS_BLOCK_LIMIT); rebuilding snapshot without blocking"
        bootstrap_snapshot
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    log "reconcile: $_nnew package(s) to block (notify now, block async)"
    notify_block_candidates "$_newfile"
    prune_uninstalled_from_snapshot "$current"
    enqueue_block_packages "$_newfile"
    rm -f "$_newfile"
    rmdir "$LOCK" 2>/dev/null
    if [ -s "$BLOCK_QUEUE" ] && [ -z "${BLOCK_WORKER_PID:-}" ]; then
        run_block_queue_pass
    fi
}

is_allow_queue_event() {
    for arg in "$@"; do
        case "$arg" in
            allow_queue|firewall_default_deny_allow|*/allow_queue|*/firewall_default_deny_allow*)
                return 0
                ;;
        esac
    done
    return 1
}

is_package_db_event() {
    for arg in "$@"; do
        case "$arg" in
            packages.xml|packages.list|*/packages.xml|*/packages.list)
                return 0
                ;;
        esac
    done
    return 1
}

case "$1" in
    --allow)
        _pkg="$2"
        if [ -z "$_pkg" ]; then
            echo "usage: firewall-watcher --allow <package>" >&2
            exit 2
        fi
        allow_one_package "$_pkg" ""
        exit $?
        ;;
    --reconcile)
        reconcile
        exit 0
        ;;
    "")
        ;;
    *)
        if is_package_db_event "$@"; then
            reconcile_install_event
            reconcile
        elif is_allow_queue_event "$@"; then
            process_allow_queue
        fi
        exit 0
        ;;
esac

if [ ! -x "$FIREWALLCTL" ]; then
    log "ERROR: $FIREWALLCTL missing; module overlay not mounted?"
fi

if [ -f "$LOGFILE" ] && [ "$(wc -l < "$LOGFILE")" -gt 500 ]; then
    tail -n 500 "$LOGFILE" > "$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
fi

rmdir "$LOCK" 2>/dev/null

cleanup() {
    [ -n "$ALLOW_QUEUE_PID" ] && kill "$ALLOW_QUEUE_PID" 2>/dev/null
    [ -n "$ALLOW_FIFO_PID" ] && kill "$ALLOW_FIFO_PID" 2>/dev/null
    [ -n "$BLOCK_WORKER_PID" ] && kill "$BLOCK_WORKER_PID" 2>/dev/null
    [ -n "$INOTIFY_SUP_PID" ] && kill "$INOTIFY_SUP_PID" 2>/dev/null
    rmdir "$LOCK" 2>/dev/null
    rmdir "$STATE_DIR/allow_queue.lock" 2>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

log "firewall-watcher build=notify-apk-v33"

if command -v inotifyd >/dev/null 2>&1; then
    log "watcher starting (inotifyd + allow fifo, safety poll ${SAFETY_INTERVAL}s)"
else
    log "watcher starting (inotifyd MISSING, safety poll ${SAFETY_INTERVAL}s only)"
fi

start_block_worker
reconcile
process_allow_queue
start_allow_queue_poller
start_allow_fifo_reader

(
    while true; do
        if command -v inotifyd >/dev/null 2>&1; then
            _targets="$PACKAGES_LIST $WATCH_DIR/packages.xml"
            [ -e "$ALLOW_QUEUE_LOCAL" ] && _targets="$_targets $ALLOW_QUEUE_LOCAL:w"
            [ -e "$ALLOW_QUEUE" ] && _targets="$_targets $ALLOW_QUEUE:w"
            # shellcheck disable=SC2086
            inotifyd "$0" $_targets 2>>"$LOGFILE"
            log "inotifyd exited rc=$?, restarting in 5s"
            sleep 5
        else
            sleep 3600
        fi
    done
) &
INOTIFY_SUP_PID=$!

while true; do
    sleep "$SAFETY_INTERVAL"
    reconcile
done
