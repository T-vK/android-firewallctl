#!/system/bin/sh
# firewall-watcher: default-deny for newly installed / reinstalled user apps.
#
# In-memory install baseline only (no known.txt). On start, read packages.list /
# pm list into RAM; on change, line-diff vs RAM, notify, async block. Manual
# allowlist.txt is read-only (sideload exemptions). inotifyd callbacks only poke
# a wake fifo so the long-running daemon keeps the baseline in one process.
#
# Modes:
#   firewall-watcher                 daemon (service.sh)
#   firewall-watcher --wake [files]  inotifyd stub: signal daemon, exit
#   firewall-watcher --reconcile     wake daemon or one-shot reconcile
#   firewall-watcher --allow PKG     allow network (or queue if blocking)

STATE_DIR="${FIREWALL_STATE_DIR:-/data/adb/firewall_default_deny}"
ALLOWLIST="$STATE_DIR/allowlist.txt"
LOGFILE="$STATE_DIR/watcher.log"
PIDFILE="$STATE_DIR/watcher.pid"
WAKE_FIFO="$STATE_DIR/package_events.fifo"
LOCK="$STATE_DIR/reconcile.lock"
WATCH_DIR="${FIREWALL_WATCH_DIR:-/data/system}"
PACKAGES_LIST="${FIREWALL_PACKAGES_LIST:-/data/system/packages.list}"
NOTIFY_CHANNEL_READY=0
NOTIFY_VERIFY_MAX="${FIREWALL_NOTIFY_VERIFY_MAX:-5}"
NOTIFY_VERIFY_SLEEP="${FIREWALL_NOTIFY_VERIFY_SLEEP:-0.05}"
FIREWALLCTL="${FIREWALLCTL:-/system/bin/firewallctl}"
MASS_BLOCK_LIMIT="${FIREWALL_MASS_BLOCK_LIMIT:-10}"
MIN_USER_PACKAGES="${FIREWALL_MIN_USER_PACKAGES:-5}"
WATCHER_BIN="${FIREWALL_WATCHER_BIN:-/system/bin/firewall-watcher}"
[ -x "$WATCHER_BIN" ] || WATCHER_BIN="$0"
case "$WATCHER_BIN" in /*) ;; *) WATCHER_BIN="/system/bin/firewall-watcher" ;; esac
BLOCK_QUEUE="$STATE_DIR/block_queue"

# In-memory baseline: "pkg uid" lines (never written to disk).
BASELINE=""
BASELINE_READY=0
DIFF_OLD_BASELINE_FILE="$STATE_DIR/.diff_old_baseline"

mkdir -p "$STATE_DIR"
touch "$ALLOWLIST"
touch "$BLOCK_QUEUE" 2>/dev/null || true
ALLOW_QUEUE="$STATE_DIR/allow_queue"
ALLOW_QUEUE_LOCAL="/data/local/tmp/firewall_default_deny_allow"
ALLOW_FIFO="/data/local/tmp/firewall_default_deny_allow.fifo"
touch "$ALLOW_QUEUE" "$ALLOW_QUEUE_LOCAL" 2>/dev/null || true
chmod 0666 "$ALLOW_QUEUE" "$ALLOW_QUEUE_LOCAL" 2>/dev/null || true
rm -f "$ALLOW_FIFO" 2>/dev/null || true
mkfifo "$ALLOW_FIFO" 2>/dev/null || true
chmod 0666 "$ALLOW_FIFO" 2>/dev/null || true

if [ -x /system/bin/pm ]; then
    AM=/system/bin/am
    PM=/system/bin/pm
    CMD=/system/bin/cmd
    APP_PROCESS=/system/bin/app_process
else
    AM=am
    PM=pm
    CMD=cmd
    APP_PROCESS=app_process
fi

NOTIFY_APK_COMPONENT="app.firewall.notify"
NOTIFY_RUNNER=app.firewall.notify.NotifyRunner
NOTIFY_CHANNEL="${FIREWALL_NOTIFY_CHANNEL:-firewall_default_deny}"

if [ ! -x "$APP_PROCESS" ] 2>/dev/null; then
    _ap=$(command -v app_process 2>/dev/null) || true
    [ -n "$_ap" ] && [ -x "$_ap" ] && APP_PROCESS="$_ap"
fi
if [ ! -x "$CMD" ] 2>/dev/null; then
    _cmd=$(command -v cmd 2>/dev/null) || true
    [ -n "$_cmd" ] && [ -x "$_cmd" ] && CMD="$_cmd"
fi
if [ ! -x "$AM" ] 2>/dev/null; then
    _am=$(command -v am 2>/dev/null) || true
    [ -n "$_am" ] && [ -x "$_am" ] && AM="$_am"
fi

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOGFILE"
}

# --- allowlist (manual file only; never written by this script) ---

is_allowlisted() {
    grep -vE '^[[:space:]]*(#|$)' "$ALLOWLIST" 2>/dev/null | grep -qxF "$1"
}

old_baseline_uid_for() {
    _pkg="$1"
    [ -f "$DIFF_OLD_BASELINE_FILE" ] || return 1
    awk -v p="$_pkg" '$1 == p && NF >= 2 { print $2; exit }' "$DIFF_OLD_BASELINE_FILE" 2>/dev/null
}

should_skip_blocking() {
    _pkg="$1"
    if ! is_allowlisted "$_pkg"; then
        return 1
    fi
    _newuid=$(package_uid "$_pkg")
    _olduid=$(old_baseline_uid_for "$_pkg")
    if [ -n "$_newuid" ] && [ -n "$_olduid" ] && [ "$_newuid" != "$_olduid" ]; then
        return 1
    fi
    if [ -z "$_olduid" ] && [ -n "$_newuid" ]; then
        awk -v p="$_pkg" '$1 == p { found=1; exit } END { exit !found }' "$DIFF_OLD_BASELINE_FILE" 2>/dev/null             && return 1
    fi
    return 0
}

# --- package list / baseline ---

count_package_lines() {
    _list="$1"
    _n=$(printf '%s\n' "$_list" | grep -cE '^[^[:space:]]' 2>/dev/null) || _n=0
    printf '%s' "$_n"
}

package_list_trusted() {
    _list="$1"
    [ "$(count_package_lines "$_list")" -ge "$MIN_USER_PACKAGES" ]
}

package_list_suspicious_drop() {
    _new="$1"
    [ "$BASELINE_READY" -eq 1 ] || return 1
    _cur=$(count_package_lines "$_new")
    _prev=$(count_package_lines "$BASELINE")
    [ "$_prev" -ge "$MIN_USER_PACKAGES" ] && [ "$_cur" -lt "$MIN_USER_PACKAGES" ]
}

current_packages() {
    "$PM" list packages -3 2>/dev/null | sed 's/^package://' | sort -u
}

package_uid() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    _uid=$("$PM" list packages -U "$_pkg" 2>/dev/null \
        | sed -n 's/.*uid:\([0-9][0-9]*\).*/\1/p' | head -1)
    if [ -n "$_uid" ]; then
        printf '%s' "$_uid"
        return 0
    fi
    [ -r "$PACKAGES_LIST" ] || return 1
    awk -v p="$_pkg" '$1 == p { print $2; exit }' "$PACKAGES_LIST" 2>/dev/null
}

# One line per app: "pkg uid" or "pkg" if uid unknown.
package_in_packages_list() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    [ -r "$PACKAGES_LIST" ] || return 1
    awk -v p="$_pkg" '$1 == p { found=1; exit } END { exit !found }' "$PACKAGES_LIST" 2>/dev/null
}

current_package_lines() {
    _lines=$("$PM" list packages -3 -U 2>/dev/null \
        | sed -n 's/^package:\([^[:space:]]*\) uid:\([0-9][0-9]*\).*/\1 \2/p' \
        | sort -u)
    if [ -n "$_lines" ]; then
        printf '%s\n' "$_lines"
        return 0
    fi
    _pkgs=$(current_packages) || return 1
    [ -n "$_pkgs" ] || return 1
    while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        _u=$(package_uid "$_p")
        if [ -n "$_u" ]; then
            printf '%s %s\n' "$_p" "$_u"
        else
            printf '%s\n' "$_p"
        fi
    done <<EOF
$_pkgs
EOF
}

baseline_set() {
    BASELINE="$1"
    BASELINE_READY=1
}

baseline_uid_for() {
    _pkg="$1"
    printf '%s\n' "$BASELINE" | awk -v p="$_pkg" '$1 == p && NF >= 2 { print $2; exit }'
}

# Write package names to block (new installs + uid change / reinstall).
find_packages_to_block() {
    _old="$1"
    _new="$2"
    _out="$3"
    : >"$_out"
    _oldnames="$STATE_DIR/.diff_old_names"
    _newnames="$STATE_DIR/.diff_new_names"
    printf '%s
' "$_old" | sed 's/ .*//' | sort -u >"$_oldnames"
    printf '%s
' "$_new" | sed 's/ .*//' | sort -u >"$_newnames"
    comm -23 "$_newnames" "$_oldnames" >>"$_out" 2>/dev/null
    _uidscan="$STATE_DIR/.diff_uid_scan"
    printf '%s
' "$_new" >"$_uidscan"
    while IFS= read -r _line || [ -n "$_line" ]; do
        [ -z "$_line" ] && continue
        _pkg=${_line%% *}
        _newuid=${_line#* }
        [ "$_pkg" = "$_line" ] && _newuid=""
        _olduid=$(printf '%s
' "$_old" | awk -v p="$_pkg" '$1 == p && NF >= 2 { print $2; exit }')
        if [ -n "$_olduid" ] && [ -n "$_newuid" ] && [ "$_olduid" != "$_newuid" ]; then
            grep -qxF "$_pkg" "$_out" 2>/dev/null || printf '%s
' "$_pkg" >>"$_out"
        elif [ -z "$_olduid" ] && [ -n "$_newuid" ]; then
            grep -qxF "$_pkg" "$_oldnames" 2>/dev/null \
                && ! grep -qxF "$_pkg" "$_out" 2>/dev/null \
                && printf '%s
' "$_pkg" >>"$_out"
        fi
    done <"$_uidscan"
    rm -f "$_uidscan" "$_oldnames" "$_newnames"
    sort -u "$_out" -o "$_out" 2>/dev/null || true
}

mass_block_detected() {
    [ "$1" -gt "$MASS_BLOCK_LIMIT" ]
}

run_firewallctl() {
    if [ ! -x "$FIREWALLCTL" ]; then
        log "ERROR: missing $FIREWALLCTL"
        return 127
    fi
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
        "$FIREWALLCTL" "$@"
        return $?
    fi
    if [ -x /system/bin/su ]; then
        /system/bin/su 0 "$FIREWALLCTL" "$@"
    else
        "$FIREWALLCTL" "$@"
    fi
}

# --- notifications (broadcast first; see notify-apk-v33+) ---

notify_apk_uid() {
    _uid=$("$PM" list packages -U "$NOTIFY_APK_COMPONENT" 2>/dev/null \
        | sed -n 's/.*uid:\([0-9]*\).*/\1/p' | head -1)
    [ -n "$_uid" ] && printf '%s' "$_uid" && return 0
    if [ -r "$PACKAGES_LIST" ]; then
        _uid=$(awk '$1 == "'"$NOTIFY_APK_COMPONENT"'" { print $2; exit }' "$PACKAGES_LIST" 2>/dev/null)
        [ -n "$_uid" ] && printf '%s' "$_uid" && return 0
    fi
    _uid=$(dumpsys package "$NOTIFY_APK_COMPONENT" 2>/dev/null \
        | sed -n 's/^[[:space:]]*userId=//p' | head -1)
    [ -n "$_uid" ] && printf '%s' "$_uid" && return 0
    return 1
}

run_as_notify_apk() {
    _uid=$(notify_apk_uid)
    if [ -n "$_uid" ] && [ -x /system/bin/su ]; then
        /system/bin/su "$_uid" "$@"
        return $?
    fi
    "$@"
}

notify_module_apk() {
    _mod="${MODDIR:-/data/adb/modules/firewall_default_deny}"
    [ -f "$_mod/system/priv-app/FirewallNotify/FirewallNotify.apk" ] \
        && echo "$_mod/system/priv-app/FirewallNotify/FirewallNotify.apk" && return 0
    [ -f "$_mod/FirewallNotify.apk" ] && echo "$_mod/FirewallNotify.apk" && return 0
    return 1
}

notify_apk_path() {
    _p=$("$PM" path "$NOTIFY_APK_COMPONENT" 2>/dev/null | head -1 | sed 's/^package://')
    [ -n "$_p" ] && [ -f "$_p" ] && echo "$_p" && return 0
    if [ -f /system/priv-app/FirewallNotify/FirewallNotify.apk ]; then
        echo /system/priv-app/FirewallNotify/FirewallNotify.apk
        return 0
    fi
    notify_module_apk
}

notify_apk_on_disk() {
    notify_apk_path >/dev/null 2>&1
}

notify_unsuspend_app() {
    if [ -x "$CMD" ]; then
        "$CMD" notification unsuspend_package "$NOTIFY_APK_COMPONENT" \
            >>"$LOGFILE" 2>&1 || true
    fi
}

notify_grant_permissions() {
    notify_unsuspend_app
    "$PM" grant "$NOTIFY_APK_COMPONENT" android.permission.POST_NOTIFICATIONS \
        >>"$LOGFILE" 2>&1 || true
    if [ -x "$CMD" ]; then
        "$CMD" appops set "$NOTIFY_APK_COMPONENT" POST_NOTIFICATION allow \
            >>"$LOGFILE" 2>&1 || true
    fi
}

notify_verify_posted() {
    _pkg="$1"
    if [ "$_pkg" = "__firewall_notify_init__" ]; then
        return 0
    fi
    if [ -n "${FIREWALL_SKIP_NOTIFY_VERIFY:-}" ] || ! command -v dumpsys >/dev/null 2>&1; then
        return 0
    fi
    _tag="firewall_default_deny_${_pkg}"
    _vf="$STATE_DIR/.notify_verify_dump"
    _n=0
    while [ "$_n" -lt "$NOTIFY_VERIFY_MAX" ]; do
        dumpsys notification --noredact 2>/dev/null >"$_vf" || : >"$_vf"
        if grep -q "$_tag" "$_vf" 2>/dev/null; then
            rm -f "$_vf" 2>/dev/null
            return 0
        fi
        if grep -q "pkg=app.firewall.notify" "$_vf" 2>/dev/null                 && grep -qF "$_pkg" "$_vf" 2>/dev/null; then
            rm -f "$_vf" 2>/dev/null
            return 0
        fi
        _n=$((_n + 1))
        sleep "$NOTIFY_VERIFY_SLEEP"
    done
    rm -f "$_vf" 2>/dev/null
    log "notify: verify failed (no active notification for $_pkg in dumpsys)"
    return 1
}

install_notify_apk_if_missing() {
    notify_apk_on_disk && return 0
    _apk=$(notify_module_apk) || {
        log "notify: FirewallNotify.apk not found under module dir"
        return 1
    }
    log "notify: no APK on device; attempting pm install (module update / missing priv-app)"
    cp "$_apk" /data/local/tmp/FirewallNotify-install.apk 2>>"$LOGFILE" || return 1
    chmod 644 /data/local/tmp/FirewallNotify-install.apk 2>/dev/null || true
    if "$PM" install -r -g -d --user 0 /data/local/tmp/FirewallNotify-install.apk >>"$LOGFILE" 2>&1; then
        log "notify: installed FirewallNotify via pm"
        return 0
    fi
    if [ -x "$CMD" ] && "$CMD" package install -r -g --user 0 -t \
            /data/local/tmp/FirewallNotify-install.apk >>"$LOGFILE" 2>&1; then
        log "notify: installed FirewallNotify via cmd package install"
        return 0
    fi
    log "notify: pm/cmd install failed (PackageManager busy?); will still try notify paths"
    return 1
}

ensure_notify_ready() {
    # Best-effort only — never gate posting on pm path (PM often busy during installs).
    if notify_apk_on_disk; then
        notify_grant_permissions
        return 0
    fi
    install_notify_apk_if_missing || true
    notify_grant_permissions
    notify_apk_on_disk
}

notify_shell_cmd() {
    _pkg="$1"
    _tag="firewall_default_deny_${_pkg}"
    _title="Internet blocked for new app"
    _body="${_pkg} was installed and network access was disabled by default."
    _err="$STATE_DIR/.notify_cmd_err"
    if [ -x "$CMD" ]; then
        _cmd_post() {
            "$@" notification post                 -p "$NOTIFY_APK_COMPONENT"                 -o "$NOTIFY_CHANNEL"                 -S bigtext                 -t "$_title"                 "$_tag"                 "$_body"
        }
        if [ "$(id -u 2>/dev/null)" = "0" ]; then
            if _cmd_post "$CMD" >>"$LOGFILE" 2>"$_err"; then
                notify_verify_posted "$_pkg" && return 0
                log "notify: cmd post ok but verify failed for $_pkg"
            else
                log "notify: cmd post failed (root): $(tr '\n' ' ' <"$_err" 2>/dev/null | head -c 400)"
            fi
        fi
        if [ -x /system/bin/su ]; then
            if _cmd_post /system/bin/su 2000 "$CMD" >>"$LOGFILE" 2>"$_err"; then
                notify_verify_posted "$_pkg" && return 0
                log "notify: cmd post (su 2000) ok but verify failed for $_pkg"
            else
                log "notify: cmd post failed (su 2000): $(tr '\n' ' ' <"$_err" 2>/dev/null | head -c 400)"
            fi
        fi
        [ -s "$_err" ] && cat "$_err" >>"$LOGFILE" 2>/dev/null
    fi
    rm -f "$_err" 2>/dev/null
    return 1
}

notify_via_foreground_service() {
    _pkg="$1"
    _comp="${NOTIFY_APK_COMPONENT}/.NotifyService"
    _err="$STATE_DIR/.notify_fgs_err"
    for _try in \
        "start-foreground-service" \
        "startforegroundservice" \
        "start-service" \
        "startservice"
    do
        case "$_try" in
            start-foreground-service|startforegroundservice)
                if "$AM" "$_try" --user 0 -n "$_comp" --es package "$_pkg" >>"$LOGFILE" 2>"$_err"; then
                    sleep 0.5
                    notify_verify_posted "$_pkg" && return 0
                    log "notify: $_try ok but verify failed for $_pkg"
                fi
                ;;
            *)
                if "$AM" "$_try" --user 0 -n "$_comp" --es package "$_pkg" >>"$LOGFILE" 2>"$_err"; then
                    sleep 0.5
                    notify_verify_posted "$_pkg" && return 0
                fi
                ;;
        esac
        [ -s "$_err" ] && cat "$_err" >>"$LOGFILE" 2>/dev/null
        : >"$_err"
    done
    if [ -s "$_err" ]; then
        log "notify: foreground_service paths failed: $(tr '\n' ' ' <"$_err" | head -c 300)"
    fi
    rm -f "$_err" 2>/dev/null
    return 1
}

notify_via_activity() {
    _pkg="$1"
    _comp="${NOTIFY_APK_COMPONENT}/.PostNotificationActivity"
    if run_as_notify_apk "$AM" start --user 0 -f 0x10000000 \
            -n "$_comp" --es package "$_pkg" >>"$LOGFILE" 2>&1; then
        sleep 0.4
        notify_verify_posted "$_pkg" && return 0
        log "notify: activity (su) started but verify failed for $_pkg"
    fi
    if "$AM" start --user 0 -f 0x10000000 \
            -n "$_comp" --es package "$_pkg" >>"$LOGFILE" 2>&1; then
        sleep 0.4
        notify_verify_posted "$_pkg" && return 0
        log "notify: activity (root) started but verify failed for $_pkg"
    fi
    return 1
}

notify_via_service() {
    _pkg="$1"
    _comp="${NOTIFY_APK_COMPONENT}/.NotifyService"
    if run_as_notify_apk "$AM" startservice --user 0 \
            -n "$_comp" --es package "$_pkg" >>"$LOGFILE" 2>&1; then
        return 0
    fi
    if "$AM" startservice --user 0 \
            -n "$_comp" --es package "$_pkg" >>"$LOGFILE" 2>&1; then
        return 0
    fi
    return 1
}

notify_via_broadcast() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 1
    if [ -x "$CMD" ] && "$CMD" activity broadcast --user 0 \
            -a app.firewall.notify.SHOW_BLOCKED \
            --es package "$_pkg" \
            --receiver-foreground \
            -p app.firewall.notify >>"$LOGFILE" 2>&1; then
        sleep 0.4
        notify_verify_posted "$_pkg" && return 0
        log "notify: broadcast (cmd) ok but verify failed for $_pkg"
    fi
    if "$AM" broadcast --user 0 \
            -a app.firewall.notify.SHOW_BLOCKED \
            --es package "$_pkg" \
            --receiver-foreground \
            -p app.firewall.notify >>"$LOGFILE" 2>&1; then
        sleep 0.4
        notify_verify_posted "$_pkg" && return 0
        log "notify: broadcast (am) ok but verify failed for $_pkg"
    fi
    if "$AM" broadcast --user 0 \
            -a app.firewall.notify.SHOW_BLOCKED \
            --es package "$_pkg" \
            -n "${NOTIFY_APK_COMPONENT}/.NotifyReceiver" >>"$LOGFILE" 2>&1; then
        sleep 0.4
        notify_verify_posted "$_pkg" && return 0
    fi
    return 1
}

run_notify_apk_runner() {
    _runner="$1"
    shift
    _apk=$(notify_apk_path) || return 1
    [ -x "$APP_PROCESS" ] || return 1
    _out="$STATE_DIR/.notify_runner_out"
    _err="$STATE_DIR/.notify_runner_err"
    : >"$_out"
    : >"$_err"
    _uid=$(notify_apk_uid)
    _rc=1
    if [ -n "$_uid" ] && [ -x /system/bin/su ]; then
        _args=""
        for _a in "$@"; do
            _esc=$(printf '%s' "$_a" | sed "s/'/'''/g")
            _args="$_args '$_esc'"
        done
        /system/bin/su "$_uid" /system/bin/sh -c             "CLASSPATH='$_apk' exec '$APP_PROCESS' /system/bin --nice-name=firewall-notify '$_runner'$_args"             >"$_out" 2>"$_err"
        _rc=$?
    else
        CLASSPATH="$_apk" "$APP_PROCESS" /system/bin --nice-name=firewall-notify             "$_runner" "$@" >"$_out" 2>"$_err"
        _rc=$?
    fi
    _posted=0
    grep -qE 'NotifyRunner: (posted|channel ready)' "$_out" 2>/dev/null && _posted=1
    cat "$_out" >>"$LOGFILE" 2>/dev/null
    cat "$_err" >>"$LOGFILE" 2>/dev/null
    rm -f "$_out" "$_err" 2>/dev/null
    _run_pkg=""
    for _a in "$@"; do
        _run_pkg="$_a"
    done
    if [ "$_rc" -eq 0 ] && [ "$_posted" -eq 1 ]; then
        if [ "$_run_pkg" = "__firewall_notify_init__" ]; then
            return 0
        fi
        if [ "${FIREWALL_NOTIFY_TRUST_RUNNER:-1}" = "1" ]; then
            return 0
        fi
        if notify_verify_posted "$_run_pkg"; then
            return 0
        fi
        log "notify: app_process posted but verify failed for $_run_pkg"
        return 1
    fi
    return 1
}


notify_ensure_channel() {
    if run_notify_apk_runner "$NOTIFY_RUNNER" "__firewall_notify_init__"; then
        return 0
    fi
    _comp="${NOTIFY_APK_COMPONENT}/.NotifyService"
    "$AM" start-foreground-service --user 0 -n "$_comp"         --es package __firewall_notify_init__ >>"$LOGFILE" 2>&1         || "$AM" startservice --user 0 -n "$_comp"         --es package __firewall_notify_init__ >>"$LOGFILE" 2>&1         || true
    sleep 0.3
    return 0
}

notify_user_inner() {
    _nui_pkg="$1"
    [ -n "$_nui_pkg" ] || return 1
    if ! notify_apk_on_disk; then
        ensure_notify_ready
    fi
    if [ "$NOTIFY_CHANNEL_READY" -eq 0 ]; then
        notify_ensure_channel || true
        NOTIFY_CHANNEL_READY=1
    fi

    if run_notify_apk_runner "$NOTIFY_RUNNER" "$_nui_pkg"; then
        log "notify: path=app_process pkg=$_nui_pkg"
        return 0
    fi

    log "notify: app_process failed; trying fallback paths for $_nui_pkg"
    if notify_via_broadcast "$_nui_pkg"; then
        log "notify: path=broadcast pkg=$_nui_pkg"
        return 0
    fi
    if notify_via_foreground_service "$_nui_pkg"; then
        log "notify: path=foreground_service pkg=$_nui_pkg"
        return 0
    fi
    if notify_via_activity "$_nui_pkg"; then
        log "notify: path=activity pkg=$_nui_pkg"
        return 0
    fi
    if notify_shell_cmd "$_nui_pkg"; then
        log "notify: path=cmd pkg=$_nui_pkg"
        return 0
    fi
    if notify_via_service "$_nui_pkg"; then
        if [ "${FIREWALL_NOTIFY_TRUST_RUNNER:-1}" = "1" ] || notify_verify_posted "$_nui_pkg"; then
            log "notify: path=service pkg=$_nui_pkg"
            return 0
        fi
    fi
    return 1
}

notify_user() {
    _pkg="$1"
    [ -n "$_pkg" ] || return 0
    if [ -n "${FIREWALL_NOTIFY_CMD:-}" ]; then
        "$FIREWALL_NOTIFY_CMD" "$_pkg" >>"$LOGFILE" 2>&1 && return 0
    fi
    if notify_user_inner "$_pkg"; then
        log "notify: posted for $_pkg"
    else
        log "ERROR: notify failed for $_pkg (all paths; see log above)"
    fi
}

notify_block_list() {
    _list="$1"
    [ -s "$_list" ] || return 0
    while IFS= read -r _pkg || [ -n "$_pkg" ]; do
        [ -n "$_pkg" ] || continue
        notify_user "$_pkg"
    done <"$_list"
}

# --- async block queue ---

apply_block_policy() {
    _pkg="$1"
    _max="${FIREWALL_BLOCK_RETRY_MAX:-20}"
    _delay="${FIREWALL_BLOCK_RETRY_DELAY:-1}"
    if should_skip_blocking "$_pkg"; then
        log "skip $_pkg (allowlisted)"
        return 0
    fi
    _try=0
    while [ "$_try" -lt "$_max" ]; do
        if ! package_in_packages_list "$_pkg"; then
            _try=$((_try + 1))
            [ "$_try" -lt "$_max" ] && sleep "$_delay"
            continue
        fi
        _err="$STATE_DIR/.block_err"
        if run_firewallctl set "$_pkg" +REJECT_ALL >>"$LOGFILE" 2>"$_err"; then
            rm -f "$_err" 2>/dev/null
            log "blocked $_pkg"
            return 0
        fi
        if grep -qF "package not found" "$_err" 2>/dev/null; then
            cat "$_err" >>"$LOGFILE" 2>/dev/null || true
            rm -f "$_err" 2>/dev/null
            _try=$((_try + 1))
            [ "$_try" -lt "$_max" ] && sleep "$_delay"
            continue
        fi
        cat "$_err" >>"$LOGFILE" 2>/dev/null || true
        rm -f "$_err" 2>/dev/null
        break
    done
    log "ERROR: firewallctl set +REJECT_ALL failed for $_pkg (after $_try wait(s))"
    return 1
}

enqueue_block_packages() {
    _list="$1"
    [ -s "$_list" ] || return 0
    while IFS= read -r _pkg || [ -n "$_pkg" ]; do
        [ -n "$_pkg" ] || continue
        if should_skip_blocking "$_pkg"; then
            log "skip $_pkg (allowlisted)"
            continue
        fi
        grep -qxF "$_pkg" "$BLOCK_QUEUE" 2>/dev/null && continue
        printf '%s\n' "$_pkg" >>"$BLOCK_QUEUE"
    done <"$_list"
}

run_block_queue_pass() {
    while [ -s "$BLOCK_QUEUE" ]; do
        _pkg=$(head -1 "$BLOCK_QUEUE" 2>/dev/null)
        [ -n "$_pkg" ] || break
        _rest="$STATE_DIR/.block_queue_rest"
        tail -n +2 "$BLOCK_QUEUE" 2>/dev/null >"$_rest" || : >"$_rest"
        mv "$_rest" "$BLOCK_QUEUE"
        apply_block_policy "$_pkg"
        process_allow_queue
    done
    rm -f "$DIFF_OLD_BASELINE_FILE" 2>/dev/null
}

start_block_worker() {
    (
        while true; do
            if [ -s "$BLOCK_QUEUE" ]; then
                if mkdir "$STATE_DIR/block_worker.lock" 2>/dev/null; then
                    run_block_queue_pass
                    rmdir "$STATE_DIR/block_worker.lock" 2>/dev/null
                fi
            fi
            sleep 0.25
        done
    ) &
    BLOCK_WORKER_PID=$!
}

# --- allow queue ---

notify_apk_data_dir() {
    [ -d "/data/user/0/$NOTIFY_APK_COMPONENT" ] && echo "/data/user/0/$NOTIFY_APK_COMPONENT" && return 0
    [ -d "/data/data/$NOTIFY_APK_COMPONENT" ] && echo "/data/data/$NOTIFY_APK_COMPONENT" && return 0
    return 1
}

notify_allow_complete_cache() {
    _pkg="$1"
    _base=$(notify_apk_data_dir) || return 1
    _cache="$_base/cache"
    _marker="$_cache/firewall_allow_complete"
    mkdir -p "$_cache" 2>/dev/null || return 1
    printf '%s\n' "$_pkg" >"$_marker"
    return 0
}

notify_allow_complete() {
    _pkg="$1"
    notify_allow_complete_cache "$_pkg" && return 0
    "$AM" broadcast --user 0 \
        -a app.firewall.notify.ALLOW_COMPLETE \
        --es package "$_pkg" \
        -p app.firewall.notify >>"$LOGFILE" 2>&1
}

parse_allow_line() {
    _line="$1"
    _pkg="${_line%%	*}"
    _marker="${_line#*	}"
    [ "$_pkg" = "$_marker" ] && _marker=""
    _pkg=$(printf '%s' "$_pkg" | tr -d '\r\n')
    _marker=$(printf '%s' "$_marker" | tr -d '\r\n')
}

is_block_queued() {
    _pkg="$1"
    [ -n "$_pkg" ] && grep -qxF "$_pkg" "$BLOCK_QUEUE" 2>/dev/null
}

enqueue_allow_request() {
    _pkg="$1"
    _marker="${2:-}"
    if [ -n "$_marker" ]; then
        printf '%s\t%s\n' "$_pkg" "$_marker" >>"$ALLOW_QUEUE_LOCAL"
        printf '%s\t%s\n' "$_pkg" "$_marker" >>"$ALLOW_QUEUE"
    else
        printf '%s\n' "$_pkg" >>"$ALLOW_QUEUE_LOCAL"
        printf '%s\n' "$_pkg" >>"$ALLOW_QUEUE"
    fi
}

allow_one_package() {
    _pkg="$1"
    _marker="${2:-}"
    [ -n "$_pkg" ] || return 1
    if is_block_queued "$_pkg"; then
        enqueue_allow_request "$_pkg" "$_marker"
        log "allow: queued $_pkg (block in progress)"
        return 0
    fi
    if [ ! -x /system/bin/firewall-allow-app ]; then
        log "allow: missing firewall-allow-app"
        return 1
    fi
    if /system/bin/firewall-allow-app "$_pkg" >>"$LOGFILE" 2>&1; then
        log "allow: allowed $_pkg"
        notify_allow_complete "$_pkg"
        return 0
    fi
    log "allow: failed for $_pkg"
    return 1
}

process_allow_queue() {
    _lock="$STATE_DIR/allow_queue.lock"
    mkdir "$_lock" 2>/dev/null || return 0
    for _q in "$ALLOW_QUEUE_LOCAL" "$ALLOW_QUEUE"; do
        [ -s "$_q" ] || continue
        while IFS= read -r _line || [ -n "$_line" ]; do
            [ -z "$_line" ] && continue
            parse_allow_line "$_line"
            allow_one_package "$_pkg" "$_marker"
        done <"$_q"
        : >"$_q"
    done
    rmdir "$_lock" 2>/dev/null
}

start_allow_queue_poller() {
    (
        while true; do
            process_allow_queue
            sleep 1
        done
    ) &
    ALLOW_QUEUE_PID=$!
}

start_allow_fifo_reader() {
    (
        while true; do
            process_allow_queue
            [ -p "$ALLOW_FIFO" ] || { sleep 1; continue; }
            if read -r _line <"$ALLOW_FIFO" 2>/dev/null; then
                [ -z "$_line" ] && continue
                parse_allow_line "$_line"
                allow_one_package "$_pkg" "$_marker"
            fi
        done
    ) &
    ALLOW_FIFO_PID=$!
}

# --- core: diff packages.list vs in-memory baseline ---

wake_daemon() {
    _why="${1:-unknown}"
    if [ -p "$WAKE_FIFO" ]; then
        printf '%s\n' "$_why" >>"$WAKE_FIFO" 2>/dev/null
    fi
}

handle_package_list_change() {
    if ! mkdir "$LOCK" 2>/dev/null; then
        return 0
    fi
    _new=$(current_package_lines) || _new=""
    if ! package_list_trusted "$_new"; then
        _n=$(count_package_lines "$_new")
        log "SAFETY: untrusted package list ($_n < $MIN_USER_PACKAGES); ignoring"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if package_list_suspicious_drop "$_new"; then
        log "SAFETY: suspicious drop vs in-memory baseline; ignoring"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    if [ "$BASELINE_READY" -eq 0 ]; then
        baseline_set "$_new"
        _n=$(count_package_lines "$_new")
        log "baseline: $_n packages in memory (no blocking)"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    _block="$STATE_DIR/.to_block"
    printf '%s\n' "$BASELINE" >"$DIFF_OLD_BASELINE_FILE"
    find_packages_to_block "$BASELINE" "$_new" "$_block"
    if [ ! -s "$_block" ]; then
        baseline_set "$_new"
        rmdir "$LOCK" 2>/dev/null
        rm -f "$_block"
        return 0
    fi
    _n=$(wc -l <"$_block" | tr -d ' ')
    if mass_block_detected "$_n"; then
        log "SAFETY: $_n changes (limit $MASS_BLOCK_LIMIT); updated baseline only"
        baseline_set "$_new"
        rm -f "$_block"
        rmdir "$LOCK" 2>/dev/null
        return 0
    fi
    log "change: $_n package(s) to block (notify now, block async)"
    notify_block_list "$_block"
    enqueue_block_packages "$_block"
    baseline_set "$_new"
    rm -f "$_block"
    rmdir "$LOCK" 2>/dev/null
    if [ -s "$BLOCK_QUEUE" ] && [ -z "${BLOCK_WORKER_PID:-}" ]; then
        run_block_queue_pass
    fi
}

establish_baseline_when_ready() {
    _n=0
    while [ "$_n" -lt 30 ]; do
        _lines=$(current_package_lines) || _lines=""
        if package_list_trusted "$_lines"; then
            baseline_set "$_lines"
            log "baseline: $(count_package_lines "$_lines") packages loaded from system"
            return 0
        fi
        _n=$((_n + 1))
        sleep 2
    done
    log "WARN: could not load trusted package list yet (will retry on change)"
    return 1
}


build_inotify_targets() {
    # Watch /data/system dir; callback ignores non-package noise. Survives packages.xml
    # AtomicFile replace (per-file watches get IN_IGNORED and kill inotifyd).
    if [ -d "$WATCH_DIR" ]; then
        printf '%s' "$WATCH_DIR"
        return 0
    fi
    _out=""
    for _f in "$PACKAGES_LIST" "$WATCH_DIR/packages.xml"; do
        [ -n "$_f" ] || continue
        [ -e "$_f" ] || continue
        _out="$_out $_f"
    done
    printf '%s' "$_out" | sed 's/^ //'
}

run_inotifyd_once() {
    _targets=$(build_inotify_targets)
    if [ -z "$_targets" ]; then
        log "ERROR: inotifyd: no watch targets (WATCH_DIR=$WATCH_DIR PACKAGES_LIST=$PACKAGES_LIST)"
        return 1
    fi
    log "inotifyd: exec $WATCHER_BIN $_targets"
    # shellcheck disable=SC2086
    inotifyd "$WATCHER_BIN" $_targets 2>>"$LOGFILE"
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        log "ERROR: inotifyd exited rc=$_rc (install detection down until fixed; see inotifyd errors above)"
    fi
    return "$_rc"
}

is_package_db_event() {
    for _arg in "$@"; do
        _base=${_arg##*/}
        case "$_arg" in
            */packages.xml|*/packages.list|*/packages.xml.new|*/packages.list.new)
                return 0
                ;;
        esac
        case "$_base" in
            packages.xml|packages.list|packages.xml.new|packages.list.new)
                return 0
                ;;
        esac
    done
    return 1
}


# --- dispatch ---

log_lines_since_mark() {
    _m="$1"
    _tail="${2:-25}"
    [ -f "$LOGFILE" ] || return 0
    awk -v m="$_m" '
        index($0, m) { p=1; next }
        p && /notify:|NotifyRunner|NotifyService|test-notify:|ERROR: notify/ { print }
    ' "$LOGFILE" 2>/dev/null | tail -"$_tail"
}

case "$1" in
    --wake)
        wake_daemon "inotify:callback"
        exit 0
        ;;
    --allow)
        _pkg="$2"
        [ -z "$_pkg" ] && echo "usage: firewall-watcher --allow <package>" >&2 && exit 2
        allow_one_package "$_pkg" ""
        exit $?
        ;;
    --test-notify)
        _pkg="$2"
        [ -z "$_pkg" ] && echo "usage: firewall-watcher --test-notify <package>" >&2 && exit 2
        mkdir -p "$STATE_DIR"
        log "test-notify: firing all paths for $_pkg"
        _test_mark="test-notify-$$"
        log "$_test_mark start $_pkg"
        if notify_user_inner "$_pkg"; then
            echo "OK: notification path succeeded (see $LOGFILE)"
            if [ -f "$LOGFILE" ]; then
                echo "--- watcher.log (this run) ---"
                log_lines_since_mark "$_test_mark" 25
            fi
            exit 0
        fi
        echo "FAIL: all notification paths failed (see $LOGFILE)" >&2
        if [ -f "$LOGFILE" ]; then
            echo "--- watcher.log (this run) ---"
            log_lines_since_mark "$_test_mark" 40
        fi
        exit 1
        ;;
    --reconcile)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            wake_daemon "reconcile"
            exit 0
        fi
        establish_baseline_when_ready
        handle_package_list_change
        exit 0
        ;;
    "")
        ;;
    *)
        if is_package_db_event "$@"; then
            wake_daemon "inotify:package-db"
        fi
        exit 0
        ;;
esac

# === long-running daemon (keeps BASELINE in this process) ===

if [ -f "$LOGFILE" ] && [ "$(wc -l <"$LOGFILE")" -gt 500 ]; then
    tail -n 500 "$LOGFILE" >"$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
fi

printf '%s\n' "$$" >"$PIDFILE"

rm -f "$WAKE_FIFO" 2>/dev/null
mkfifo "$WAKE_FIFO" 2>/dev/null
chmod 0666 "$WAKE_FIFO" 2>/dev/null || true

cleanup() {
    [ -n "$ALLOW_QUEUE_PID" ] && kill "$ALLOW_QUEUE_PID" 2>/dev/null
    [ -n "$ALLOW_FIFO_PID" ] && kill "$ALLOW_FIFO_PID" 2>/dev/null
    [ -n "$BLOCK_WORKER_PID" ] && kill "$BLOCK_WORKER_PID" 2>/dev/null
    [ -n "$INOTIFY_SUP_PID" ] && kill "$INOTIFY_SUP_PID" 2>/dev/null
    rm -f "$PIDFILE" 2>/dev/null
    rmdir "$LOCK" 2>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

log "firewall-watcher build=memdiff-v49"
ensure_notify_ready || log "WARN: FirewallNotify not ready; notifications may fail until install succeeds"

start_block_worker
start_allow_queue_poller
start_allow_fifo_reader
establish_baseline_when_ready

notify_ensure_channel || true
NOTIFY_CHANNEL_READY=1

if command -v inotifyd >/dev/null 2>&1; then
    log "daemon: inotifyd only (no periodic package poll — ever)"
    (
        while true; do
            run_inotifyd_once
            _irc=$?
            if [ "$_irc" -ne 0 ]; then
                log "ERROR: inotifyd failed rc=$_irc; retry in 2s (no poll fallback)"
                sleep 2
            else
                log "inotifyd: all watches ended (normal after packages.xml rewrite); restarting"
                sleep 0.25
            fi
        done
    ) &
    INOTIFY_SUP_PID=$!
else
    log "ERROR: inotifyd not in PATH — install detection disabled until fixed"
    log "ERROR: expected toybox inotifyd; manual wake only: firewall-watcher --reconcile"
fi

while read -r _wake <"$WAKE_FIFO" 2>/dev/null; do
    if [ "${FIREWALL_LOG_ALL_WAKES:-0}" = "1" ] && [ -n "$_wake" ]; then
        log "wake: $_wake"
    fi
    handle_package_list_change
done
