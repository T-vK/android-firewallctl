#!/bin/sh
# Never add Co-authored-by trailers on agent commits (repo policy).
msg_file="$1"
case "$2" in
    merge|squash) exit 0 ;;
esac
if [ -f "$msg_file" ]; then
    sed -i '/^[Cc]o-[Aa]uthored-by:/d' "$msg_file" 2>/dev/null \
        || sed -i '' '/^[Cc]o-[Aa]uthored-by:/d' "$msg_file" 2>/dev/null \
        || true
fi
